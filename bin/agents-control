#!/bin/sh
set -eu
SELF=$0
while [ -L "$SELF" ]; do
  target=$(readlink "$SELF")
  case $target in /*) SELF=$target ;; *) SELF=$(dirname "$SELF")/$target ;; esac
done
TOOLKIT_ROOT=$(cd "$(dirname "$SELF")/.." && pwd -P)
. "$TOOLKIT_ROOT/lib/context.sh"
usage() {
  cat <<'DOC'
agents-control: private notes for your coding agents.

  init              Create docs-agents-private/ and exclude it from Git.
  context           Print personal instructions for this checkout. Read-only.
  resolve DOC       Print a private document path. Does not create the document.
                    --read prints existing contents; --path also means path only.
  guard-index       Refuse private files in the Git index before a commit.
  doctor            Check this checkout. --skills-only checks toolkit sources.
  version           Print the installed version.

Run init once per checkout. No profiles or configuration required.
DOC
}
init() {
  ac_safe_path "$AC_EXCLUDE"
  if ac_exists "$AC_EXCLUDE" && [ ! -f "$AC_EXCLUDE" ]; then ac_die 'Git exclude must be a regular file'; fi
  # Exclusions are common to linked worktrees. Refuse tracked content in any of them.
  ac_worktrees=$(git -C "$AC_REPO" worktree list --porcelain) || ac_die 'cannot list worktrees'
  printf '%s\n' "$ac_worktrees" | while IFS= read -r line; do
    case $line in worktree\ *)
      checkout=${line#worktree }
      ac_text_path "$checkout"
      [ -d "$checkout" ] || continue
      indexed=$(git -C "$checkout" ls-files -- ':(icase,literal)docs-agents-private') || ac_die 'cannot check worktree index'
      [ -z "$indexed" ] || ac_die "docs-agents-private is tracked in $checkout; setup cannot hide project files"
      ;; esac
  done
  for doc in AGENTS $AC_CORE; do
    ac_safe_path "$AC_PRIVATE/$doc.md"
    if ac_exists "$AC_PRIVATE/$doc.md" && [ ! -f "$AC_PRIVATE/$doc.md" ]; then ac_die "document is not a regular file: $doc.md"; fi
  done
  if [ -f "$AC_PRIVATE/AGENTS.md" ] && ! ac_registered; then
    ac_die 'existing docs-agents-private/AGENTS.md is not agents-control guidance; move it aside before setup'
  fi
  # Append a literal root rule locally. Existing exclusions stay intact.
  if ! grep -Fxq '/docs-agents-private/' "$AC_EXCLUDE" 2>/dev/null ||
     ! git -C "$AC_REPO" check-ignore -q --no-index docs-agents-private/; then
    mkdir -p "$(dirname "$AC_EXCLUDE")"
    printf '\n# Private agents-control documents\n/docs-agents-private/\n' >> "$AC_EXCLUDE"
  fi
  git -C "$AC_REPO" check-ignore -q --no-index docs-agents-private/ || ac_die 'Git does not exclude private documents'
  mkdir -p "$AC_PRIVATE"
  for doc in $AC_CORE; do
    [ -f "$AC_PRIVATE/$doc.md" ] || cp "$TOOLKIT_ROOT/templates/docs-agents/$doc.md" "$AC_PRIVATE/$doc.md"
  done
  # Write the setup marker last. Rerunning completes an interrupted setup.
  [ -f "$AC_PRIVATE/AGENTS.md" ] || cp "$TOOLKIT_ROOT/templates/private-AGENTS.md" "$AC_PRIVATE/AGENTS.md"
  printf 'Ready: %s\nAsk your agent to run agents-control context and fill PRD.md and STACK.md from the codebase.\n' "$AC_PRIVATE"
}
check_skills() {
  for skill in $AC_SKILLS; do
    file=$TOOLKIT_ROOT/skills/$skill/SKILL.md
    [ -f "$file" ] || ac_die "missing skill: $skill"
    grep -Fxq "name: $skill" "$file" || ac_die "wrong skill name: $skill"
    awk 'NR==1 && $0!="---" {exit 1} NR>1 && $0=="---" {closed=1; exit} NR>1 && $0 !~ /^(name|description): .+/ {exit 1} END {if (!closed) exit 1}' "$file" || ac_die "invalid skill frontmatter: $skill"
  done
  [ -f "$TOOLKIT_ROOT/skills/ac-write-manual/assets/SUM.md" ] || ac_die 'missing manual template'
  printf 'Personal skills OK.\n'
}
doctor() {
  ac_require_setup
  ac_guard_index
  git -C "$AC_REPO" check-ignore -q --no-index docs-agents-private/ || ac_die 'private documents are not excluded; rerun init'
  for doc in $AC_CORE; do
    ac_safe_path "$AC_PRIVATE/$doc.md"
    [ -f "$AC_PRIVATE/$doc.md" ] || ac_die "missing $doc.md; rerun init"
  done
  printf 'Private documents and Git exclusion OK: %s\n' "$AC_PRIVATE"
}
action=${1:-help}
[ "$#" -eq 0 ] || shift
case $action in
  help|-h|--help) [ "$#" -eq 0 ] || ac_die 'help takes no arguments'; usage; exit 0 ;;
  version)
    [ "$#" -eq 0 ] || ac_die 'version takes no arguments'
    if [ -f "$TOOLKIT_ROOT/.agents-control-version" ]; then cat "$TOOLKIT_ROOT/.agents-control-version"
    else printf 'development\n'; fi
    exit 0 ;;
  doctor)
    if [ "${1:-}" = --skills-only ]; then shift; [ "${1:-}" != --strict ] || shift
      [ "$#" -eq 0 ] || ac_die 'unexpected doctor arguments'; check_skills; exit 0
    fi
    [ "${1:-}" != --strict ] || shift
    [ "$#" -eq 0 ] || ac_die 'unexpected doctor arguments' ;;
  resolve)
    [ "$#" -ge 1 ] || ac_die 'resolve needs a document name'
    doc=$(ac_doc "$1"); shift
    read_doc=
    if [ "$#" -gt 0 ]; then
      case $1 in --read) read_doc=1 ;; --path) ;; *) ac_die 'resolve accepts --read or --path' ;; esac
      shift
    fi
    [ "$#" -eq 0 ] || ac_die 'unexpected resolve arguments' ;;
  init|context|guard-index) [ "$#" -eq 0 ] || ac_die "$action takes no arguments" ;;
  *) ac_die "unknown command: $action. Run agents-control help" ;;
esac
if ! ac_load; then
  [ "$action" != context ] || exit 0
  ac_die 'not a Git checkout'
fi
case $action in
  init) init ;;
  context) ac_context ;;
  resolve)
    ac_require_setup
    path=$AC_PRIVATE/$doc
    ac_safe_path "$path"
    if [ -n "$read_doc" ]; then [ ! -f "$path" ] || cat "$path"
    else printf '%s\n' "$path"; fi ;;
  guard-index) ac_guard_index ;;
  doctor) doctor ;;
esac
